#include <assert.h>
#include <stdbool.h>
#include <string.h>
static int step;
void backlight_open(bool a, bool b, int c) { assert(step++ == 0); }
int lcd_reset_pin_higt(void) { assert(step++ == 1); return 0; }
void ak_sleep_ms(int ms) { assert(step++ == 2 && ms == 300); }
int system(const char *cmd) { assert(step++ == 3 && strcmp(cmd, "reboot") == 0); return 0; }
#include "app/app_main/src/ty_sdk_dp_callback.c"
int main(void) {
    TY_OBJ_DP_S dp = {0}; dp.type = PROP_BOOL; dp.value.dp_bool = true;
    handle_DP_REBOOT_SYSTEM(&dp);
    assert(step == 4);
    step = 0; handle_DP_REBOOT_SYSTEM(NULL);
    dp.value.dp_bool = false; handle_DP_REBOOT_SYSTEM(&dp);
    dp.type = PROP_VALUE; dp.value.dp_value = 1; handle_DP_REBOOT_SYSTEM(&dp);
    assert(step == 0);
    puts("PASS: App reboot preserves GVS LCD reset and rejects queries/invalid commands");
    return 0;
}
